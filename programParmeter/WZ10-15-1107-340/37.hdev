<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="18.11.0.1">
<procedure name="main">
<interface/>
<body>
<c>*读取模板和图像进行模板匹配*</c>
<l>read_image(Image, 'D:/temporary_sun/AxisMeasurement/measureData/WZ10-15-1107-340/20230919_144658/cam0_2.bmp')</l>
<l>get_image_size (Image, Width, Height)</l>
<l>ModelFile := 'cam0_2-340-42.sbm'</l>
<l>read_shape_model (ModelFile, ReusedModelID)</l>
<c>*创建测量模型</c>
<l>create_metrology_model (MetrologyHandle)</l>
<c>*添加直线测量工具 这里的卡尺参数要根据模板的长度进行修改</c>
<l>Line := [-54, 242, -90, 283]</l>
<l>add_metrology_object_generic (MetrologyHandle, 'line',Line, 30, 12, 1, 20, [], [], LineIndices)</l>
<c>*获取读取的模板的轮廓，区域坐标等信息</c>
<l>get_shape_model_contours (ModelContours, ReusedModelID, 1)</l>
<l>get_shape_model_origin (ReusedModelID, ReusedRefPointRow, ReusedRefPointCol)</l>
<l>get_shape_model_params (ReusedModelID, NumLevels, AngleStart, AngleExtent, AngleStep, ScaleMin, ScaleMax, ScaleStep, Metric, MinContrast)</l>
<c>*进行模板匹配</c>
<l>find_shape_model (Image, ReusedModelID, AngleStart, AngleExtent, 0.8, 1, 0.3, 'least_squares', 0, 0.7, Row3, Column3, Angle, Score)</l>
<c>*显示形状特征模板匹配结果</c>
<l>dev_display_shape_matching_results (ReusedModelID, 'red', Row3, Column3, Angle, 1, 1, 0)</l>
<l>vector_angle_to_rigid (ReusedRefPointRow, ReusedRefPointCol, 0, Row3, Column3, Angle, HomMat2D)</l>
<l>*affine_trans_contour_xld (ModelContours, ContoursAffinTrans, HomMat2D)</l>
<l>*dev_set_color ('green')</l>
<l>*dev_display (ContoursAffinTrans)</l>
<c>*对测量模型执行变换</c>
<l>align_metrology_model (MetrologyHandle, Row3, Column3, Angle)</l>
<c>*获取变换后的测量模型的轮廓</c>
<l>get_metrology_object_measures (LineContours, MetrologyHandle, 'all', 'all', RowLine, ColumnLine)</l>
<c>*卡尺找直线</c>
<l>apply_metrology_model (Image, MetrologyHandle)</l>
<c></c>
<l>dev_set_color ('yellow')</l>
<l>dev_set_line_width (2)</l>
<l>dev_display (LineContours)</l>
<l>get_metrology_object_result_contour (LineContour, MetrologyHandle, 0, 'all', 1.5)</l>
<l>*get_metrology_object_model_contour (ModelContour, MetrologyHandle, 'all', 1.5)</l>
<l>dev_set_color ('blue')</l>
<l>dev_set_line_width (2)</l>
<l>dev_display (LineContour)</l>
<l>fit_line_contour_xld (LineContour, 'tukey', -1, 0, 5, 2, RowBegin, ColBegin, RowEnd, ColEnd, Nr, Nc, Dist)</l>
<c>*输出模板匹配后检测直线两端点的位置，即特征点位置。</c>
</body>
<docu id="main">
<parameters/>
</docu>
</procedure>
</hdevelop>
