}
QMainWindow#AxisMeasurementClass QWidget#autoMeasureUI QLineEdit:disabled,
QMainWindow#AxisMeasurementClass QWidget#autoMeasureUI QSpinBox:disabled,
QMainWindow#AxisMeasurementClass QWidget#autoMeasureUI QDoubleSpinBox:disabled,
QMainWindow#AxisMeasurementClass QWidget#autoMeasureUI QComboBox:disabled {
    color: #A7AFBA;
    background: #F1F3F5;
    border-color: #E3E8EF;
}
QMainWindow#AxisMeasurementClass QWidget#autoMeasureUI QComboBox::drop-down {
    border: none;
    border-left: 1px solid #E3E8EF;
    background: #F8FAFC;
}
QMainWindow#AxisMeasurementClass QWidget#autoMeasureUI QComboBox::drop-down:hover {
    background: #EFF6FF;
}
QMainWindow#AxisMeasurementClass QWidget#autoMeasureUI QPushButton {
