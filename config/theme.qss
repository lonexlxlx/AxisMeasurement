QMainWindow#AxisMeasurementClass QWidget#leftDashboardPanel {
    background: #F5F7FA;
}
QMainWindow#AxisMeasurementClass QGroupBox#leftProcessCard,
QMainWindow#AxisMeasurementClass QGroupBox#leftLightCurtainCard {
    background: #FFFFFF;
    border: 1px solid #E3E8EF;
    border-radius: 8px;
    margin-top: 0;
    padding: 0;
    color: #334155;
    font-size: 9pt;
    font-weight: 400;
}
QMainWindow#AxisMeasurementClass QLabel#leftCardTitle {
    color: #334155;
    font-size: 10pt;
    font-weight: 600;
    padding: 2px 0 6px 0;
}
QMainWindow#AxisMeasurementClass QGroupBox#leftProcessCard QLabel,
QMainWindow#AxisMeasurementClass QGroupBox#leftLightCurtainCard QLabel {
    color: #64748B;
    font-size: 9pt;
    font-weight: 400;
}
QMainWindow#AxisMeasurementClass QGroupBox#leftProcessCard QLabel#programProcess {
    color: #64748B;
    font-weight: 600;
}
QMainWindow#AxisMeasurementClass QGroupBox#leftProcessCard QLabel#programProcess[processState="running"] {
    color: #1D4ED8;
}
QMainWindow#AxisMeasurementClass QGroupBox#leftProcessCard QLabel#programProcess[processState="complete"] {
    color: #15803D;
}
QMainWindow#AxisMeasurementClass QGroupBox#leftProcessCard QLabel#programProcess[processState="error"] {
    color: #B91C1C;
}
QMainWindow#AxisMeasurementClass QGroupBox#leftProcessCard QProgressBar {
    min-height: 18px;
    max-height: 18px;
    color: #334155;
    background: #E9EEF5;
    border: none;
    border-radius: 9px;
    text-align: center;
    font-weight: 600;
}
QMainWindow#AxisMeasurementClass QGroupBox#leftProcessCard QProgressBar::chunk {
    background: #94A3B8;
    border-radius: 9px;
}
QMainWindow#AxisMeasurementClass QGroupBox#leftProcessCard QProgressBar[progressState="running"]::chunk {
    background: #2563EB;
}
QMainWindow#AxisMeasurementClass QGroupBox#leftProcessCard QProgressBar[progressState="complete"]::chunk {
    background: #16A34A;
}
QMainWindow#AxisMeasurementClass QGroupBox#leftProcessCard QProgressBar[progressState="error"]::chunk {
    background: #DC2626;
}
QMainWindow#AxisMeasurementClass QLabel#lsDiameter,
QMainWindow#AxisMeasurementClass QLabel#lsCurrentValue {
    border-radius: 6px;
    padding: 4px 8px;
    font-weight: 700;
}
QMainWindow#AxisMeasurementClass QLabel#lsDiameter[displayRole="measurement"] {
    color: #1D4ED8;
    background: #EFF6FF;
    border: 1px solid #BFDBFE;
}
QMainWindow#AxisMeasurementClass QLabel#lsCurrentValue[displayRole="realtime"] {
    color: #64748B;
    background: #F8FAFC;
    border: 1px solid #E3E8EF;
}
QMainWindow#AxisMeasurementClass QLabel#lsCurrentValue[displayState="active"] {
    color: #15803D;
    background: #F0FDF4;
    border-color: #BBF7D0;
}
QMainWindow#AxisMeasurementClass QTabWidget#autoAdjustTabs::pane {
    background: #FFFFFF;
    border: 1px solid #E3E8EF;
    border-radius: 6px;
    top: -1px;
}
QMainWindow#AxisMeasurementClass QTabWidget#autoAdjustTabs QTabBar::tab {
    color: #64748B;
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 7px 12px;
}
QMainWindow#AxisMeasurementClass QTabWidget#autoAdjustTabs QTabBar::tab:selected {
    color: #2563EB;
    background: #FFFFFF;
    border-bottom-color: #2563EB;
}
QMainWindow#AxisMeasurementClass QTabWidget#autoAdjustTabs QTabBar::tab:hover:!selected {
    color: #334155;
    background: #F8FAFC;
}
QMainWindow#AxisMeasurementClass QWidget#autoMoveAdjust QLabel[textRole="sectionTitle"] {
    color: #334155;
    background: transparent;
    font-size: 10pt;
    font-weight: 600;
}
QMainWindow#AxisMeasurementClass QWidget#autoMoveAdjust QPushButton[controlRole="motion"] {
    color: #475569;
    background: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 5px;
    font-weight: 600;
}
QMainWindow#AxisMeasurementClass QWidget#autoMoveAdjust QPushButton[controlRole="motion"]:hover {
