    background: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 5px;
}
QMainWindow#AxisMeasurementClass QWidget#autoMeasureUI QPushButton:hover {
    color: #2563EB;
    background: #EFF6FF;
    border-color: #93B4E8;
}
QMainWindow#AxisMeasurementClass QWidget#autoMeasureUI QPushButton:pressed {
    color: #1D4ED8;
    background: #DBEAFE;
    border-color: #2563EB;
}
QMainWindow#AxisMeasurementClass QWidget#autoMeasureUI QPushButton:focus {
    border-color: #2563EB;
}
QMainWindow#AxisMeasurementClass QWidget#autoMeasureUI QPushButton:disabled {
    color: #A7AFBA;
    background: #F1F3F5;
    border-color: #E3E8EF;
}
