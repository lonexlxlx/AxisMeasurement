/* ============================================================
   AxisMeasurement 全局界面主题 v1.0（2026-09-09）
   载入方式：main.cpp 中 QApplication::setStyleSheet() 自动读取本文件
   回滚方式：删除本文件即可恢复 Qt 默认样式（程序会静默跳过）
   配色规范：
     主色(工业蓝) #2563EB    页面底 #F3F4F6    卡片底 #FFFFFF
     边框 #E5E7EB    正文 #1F2937    次要文字 #6B7280
     语义色：成功 #16A34A / 警告 #D97706 / 危险 #DC2626 / 信息 #2563EB
   ============================================================ */

/* ---------- 基础：统一字体与文字色 ---------- */
QWidget {
    font-family: "Microsoft YaHei UI", "Microsoft YaHei", sans-serif;
    font-size: 9pt;
    color: #1F2937;
}
QMainWindow, QDialog { background: #F3F4F6; }

/* ---------- 分组框：卡片化 ---------- */
QGroupBox {
    font-weight: bold;
    font-size: 10pt;
    color: #374151;
    background: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 6px;
    margin-top: 12px;
    padding: 8px 6px 6px 6px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 4px;
    color: #2563EB;
    background: transparent;
}

/* ---------- 按钮：三态 ---------- */
QPushButton {
    background: #FFFFFF;
    border: 1px solid #D1D5DB;
    border-radius: 4px;
    padding: 5px 14px;
    min-height: 20px;
}
QPushButton:hover  { border-color: #2563EB; color: #2563EB; background: #EFF6FF; }
QPushButton:pressed{ background: #DBEAFE; }
QPushButton:focus  { border-color: #2563EB; }
QPushButton:disabled { color: #9CA3AF; background: #F3F4F6; border-color: #E5E7EB; }

/* ---------- 语义按钮（按控件实名匹配，无需改代码） ---------- */

/* 主操作：开始测量 */
QPushButton#startAutoMearsurement { background:#2563EB; border-color:#2563EB; color:#FFFFFF; font-weight:bold; }
QPushButton#startAutoMearsurement:hover   { background:#1D4ED8; }
QPushButton#startAutoMearsurement:pressed { background:#1E40AF; }
QPushButton#startAutoMearsurement:disabled{ background:#93C5FD; border-color:#93C5FD; color:#EFF6FF; }

/* 危险操作：紧急停止（自动测量区 + 轴控制区） */
QPushButton#urgentStop, QPushButton#urgrentStopMearsure { background:#DC2626; border-color:#DC2626; color:#FFFFFF; font-weight:bold; }
QPushButton#urgentStop:hover, QPushButton#urgrentStopMearsure:hover   { background:#B91C1C; }
QPushButton#urgentStop:pressed, QPushButton#urgrentStopMearsure:pressed { background:#991B1B; }
QPushButton#urgentStop:disabled, QPushButton#urgrentStopMearsure:disabled { background:#FCA5A5; border-color:#FCA5A5; color:#FEF2F2; }

/* 运动控制类按钮（顶尖上/下移、转台慢转/快转、光幕上/下移）：橙色描边警示，替换原荧光底色 */
QPushButton#apexMoveUp, QPushButton#apexMoveDown,
QPushButton#partRotate_clockwise, QPushButton#partRotate_anticlockwise,
QPushButton#lsMoveUp, QPushButton#lsMoveDown {
    border-color:#D97706;
    color:#B45309;
}
QPushButton#apexMoveUp:hover, QPushButton#apexMoveDown:hover,
QPushButton#partRotate_clockwise:hover, QPushButton#partRotate_anticlockwise:hover,
QPushButton#lsMoveUp:hover, QPushButton#lsMoveDown:hover {
    background:#FFF7ED;
    border-color:#D97706;
    color:#B45309;
}

/* 通用扩展：新代码中 widget->setObjectName("primaryButton"/"dangerButton") 亦可复用 */
QPushButton#primaryButton { background:#2563EB; border-color:#2563EB; color:#FFFFFF; }
QPushButton#primaryButton:hover { background:#1D4ED8; }
QPushButton#dangerButton { background:#DC2626; border-color:#DC2626; color:#FFFFFF; }
QPushButton#dangerButton:hover { background:#B91C1C; }

/* ---------- 输入控件 ---------- */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background: #FFFFFF;
    border: 1px solid #D1D5DB;
    border-radius: 4px;
    padding: 3px 6px;
    min-height: 20px;
    selection-background-color: #BFDBFE;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border: 1px solid #2563EB;
}
QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QComboBox:disabled {
    background: #F3F4F6; color: #9CA3AF;
}
QComboBox {
    padding-right: 28px;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    border: none;
    border-left: 1px solid #E5E7EB;
    width: 24px;
    background: #F9FAFB;
}
QComboBox::drop-down:hover {
    background: #EFF6FF;
}
QComboBox::down-arrow {
    image: url(config/combo_arrow.svg);
    width: 10px;
    height: 6px;
}
QComboBox::down-arrow:disabled {
    image: url(config/combo_arrow.svg);
}
QComboBox QAbstractItemView {
    background: #FFFFFF;
    border: 1px solid #E5E7EB;
    selection-background-color: #DBEAFE;
    selection-color: #1F2937;
}
/* 下拉框统一使用 SVG 小三角，避免看起来像普通输入框 */

/* ---------- 表格 ---------- */
QTableWidget {
    background: #FFFFFF;
    alternate-background-color: #F9FAFB;
    gridline-color: #E5E7EB;
    border: 1px solid #E5E7EB;
    border-radius: 4px;
    selection-background-color: #DBEAFE;
    selection-color: #111827;
}
QHeaderView::section {
    background: #F3F4F6;
    color: #374151;
    font-weight: bold;
    border: none;
    border-right: 1px solid #E5E7EB;
    border-bottom: 1px solid #E5E7EB;
    padding: 5px 8px;
}

/* ---------- 进度条 ---------- */
QProgressBar {
    background: #E5E7EB;
    border: none;
    border-radius: 6px;
    text-align: center;
    height: 14px;
    color: #374151;
}
QProgressBar::chunk { background: #2563EB; border-radius: 6px; }

/* ---------- Tab 页 ---------- */
QTabWidget::pane {
    border: 1px solid #E5E7EB;
    border-radius: 4px;
    background: #FFFFFF;
    top: -1px;
}
QTabBar::tab {
    padding: 6px 14px;
    color: #6B7280;
    border: 1px solid #E5E7EB;
    border-bottom: none;
    background: #F3F4F6;
}
QTabBar::tab:selected {
    color: #2563EB;
    background: #FFFFFF;
    border-bottom: 2px solid #2563EB;
}
QTabBar::tab:hover:!selected {
    background: #E5E7EB;
}

/* ---------- P2：Splitter 分隔条（左右面板拖动收放） ---------- */
QSplitter::handle { background: #E5E7EB; }
QSplitter::handle:horizontal { width: 4px; }
QSplitter::handle:vertical { height: 4px; }
QSplitter::handle:hover { background: #93C5FD; }
QSplitter::handle:pressed { background: #2563EB; }

/* ---------- 工具栏与工具按钮（图形化编辑器） ---------- */
QToolBar {
    background: #FFFFFF;
    border: none;
    border-bottom: 1px solid #E5E7EB;
    spacing: 3px;
    padding: 3px;
}
QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 4px 8px;
}
QToolButton:hover { background: #EFF6FF; border-color: #BFDBFE; }
QToolButton:checked {
    background: #DBEAFE;
    border-color: #2563EB;
    color: #2563EB;
    font-weight: bold;
}

/* ---------- 菜单栏 / 菜单 / 状态栏 ---------- */
QMenuBar { background: #FFFFFF; border-bottom: 1px solid #E5E7EB; }
QMenuBar::item { padding: 4px 10px; }
QMenuBar::item:selected { background: #EFF6FF; }
QMenu { background: #FFFFFF; border: 1px solid #E5E7EB; padding: 4px; }
QMenu::item { padding: 5px 24px; border-radius: 4px; }
QMenu::item:selected { background: #DBEAFE; }
QStatusBar { background: #FFFFFF; border-top: 1px solid #E5E7EB; color: #6B7280; }

/* ---------- 滚动条：细窄现代风 ---------- */
QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical { background: #D1D5DB; border-radius: 5px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: #9CA3AF; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle:horizontal { background: #D1D5DB; border-radius: 5px; min-width: 30px; }
QScrollBar::handle:horizontal:hover { background: #9CA3AF; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

/* ---------- 复选框 / 单选框 ---------- */
QCheckBox::indicator {
    width: 15px; height: 15px;
    border: 1px solid #D1D5DB;
    border-radius: 3px;
    background: #FFFFFF;
}
QCheckBox::indicator:checked { background: #2563EB; border-color: #2563EB; }
QRadioButton::indicator {
    width: 15px; height: 15px;
    border: 1px solid #D1D5DB;
    border-radius: 8px;
    background: #FFFFFF;
}
QRadioButton::indicator:checked { border: 4px solid #2563EB; }

/* ============================================================
   sdkAssist 点位记录界面：现代卡片式 UI
   ============================================================ */
QScrollArea#sdkAssistScrollArea {
    background: #F3F4F6;
    border: none;
}
QScrollArea#sdkAssistScrollArea > QWidget > QWidget {
    background: #F3F4F6;
}
QWidget#sdkAssistPage {
    background: #F3F4F6;
    font-family: "Microsoft YaHei UI", "Microsoft YaHei";
    color: #1F2937;
}
QFrame#sdkAssistHeader {
    background: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 6px;
}
QLabel#sdkAssistHeaderTitle {
    color: #111827;
    background: transparent;
    border: none;
    font-size: 14pt;
    font-weight: 700;
    padding: 0;
}
QLabel#sdkAssistHeaderSubtitle {
    color: #6B7280;
    background: transparent;
    border: none;
    font-size: 9pt;
    padding: 0;
}
QPushButton#openGraphicalEditorButton {
    min-height: 30px;
    padding: 4px 16px;
    color: #2563EB;
    background: #FFFFFF;
    border: 1px solid #2563EB;
    border-radius: 4px;
    font-weight: 600;
}
QPushButton#openGraphicalEditorButton:hover {
    color: #1D4ED8;
    background: #EFF6FF;
    border-color: #1D4ED8;
}
QPushButton#openGraphicalEditorButton:pressed {
    color: #1E40AF;
    background: #DBEAFE;
    border-color: #1E40AF;
}
QPushButton#openGraphicalEditorButton:focus {
    border: 1px solid #2563EB;
}
QLabel#sdkAssistPathHint {
    color: #6B7280;
    font-size: 9pt;
    padding: 2px 8px;
}
QGroupBox#sdkAssistCard {
    background: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 6px;
    margin-top: 0;
    padding: 0;
}
QFrame#sdkAssistCardHeader {
    background: #FFFFFF;
    border: none;
    border-bottom: 1px solid #E5E7EB;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}
QWidget#sdkAssistCardBody {
    background: #FFFFFF;
    border: none;
}
QFrame#sdkAssistCardFooter {
    background: #FFFFFF;
    border: none;
    border-top: 1px solid #F3F4F6;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}
QGroupBox#sdkAssistCard QLabel#sdkAssistModuleNumber {
    color: #2563EB;
    background: transparent;
    border: none;
    font-size: 10pt;
    font-weight: 700;
}
QGroupBox#sdkAssistCard QLabel#sdkAssistCardTitle {
    color: #111827;
    background: transparent;
    border: none;
    font-size: 10pt;
    font-weight: 700;
    padding: 0;
}
QGroupBox#sdkAssistCard QLabel#sdkAssistDeviceBadge {
    color: #6B7280;
    background: #F3F4F6;
    border: 1px solid #E5E7EB;
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 8pt;
    font-weight: 400;
}
QGroupBox#sdkAssistCard QLabel#sdkAssistModuleHint {
    color: #6B7280;
    background: #F9FAFB;
    border: 1px solid #E5E7EB;
    border-radius: 4px;
    padding: 6px 8px;
    font-size: 8pt;
}
QGroupBox#sdkAssistCard QLabel {
    color: #374151;
    font-size: 9pt;
}
QLabel#countValueLabel {
    color: #2563EB;
    font-weight: 700;
}
QWidget#sdkAssistPage QLineEdit,
QWidget#sdkAssistPage QComboBox {
    color: #111827;
    background: #FFFFFF;
    border: 1px solid #D1D5DB;
    border-radius: 4px;
    min-height: 22px;
    padding: 3px 7px;
    selection-background-color: #BFDBFE;
    selection-color: #111827;
}
QWidget#sdkAssistPage QLineEdit:hover,
QWidget#sdkAssistPage QComboBox:hover {
    border-color: #9CA3AF;
}
QWidget#sdkAssistPage QLineEdit:focus,
QWidget#sdkAssistPage QComboBox:focus {
    border: 1px solid #2563EB;
    background: #F8FBFF;
}
QWidget#sdkAssistPage QLineEdit:disabled,
QWidget#sdkAssistPage QComboBox:disabled {
    color: #9CA3AF;
    background: #F3F4F6;
    border-color: #E5E7EB;
}
QWidget#sdkAssistPage QLineEdit[readOnly="true"] {
    color: #4B5563;
    background: #F9FAFB;
    border-color: #E5E7EB;
}
QWidget#sdkAssistPage QComboBox {
    padding-right: 28px;
}
QWidget#sdkAssistPage QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left: 1px solid #E5E7EB;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    background: #F9FAFB;
}
QWidget#sdkAssistPage QComboBox::drop-down:hover {
    background: #EFF6FF;
}
QWidget#sdkAssistPage QComboBox::down-arrow {
    image: url(config/combo_arrow.svg);
    width: 10px;
    height: 6px;
}
QWidget#sdkAssistPage QComboBox QAbstractItemView {
    color: #1F2937;
    background: #FFFFFF;
    border: 1px solid #E5E7EB;
    selection-color: #1F2937;
    selection-background-color: #DBEAFE;
    outline: none;
}
QWidget#sdkAssistPage QPushButton {
    min-height: 22px;
    padding: 3px 12px;
    border: 1px solid #D1D5DB;
    border-radius: 4px;
    background: #FFFFFF;
    color: #374151;
    font-weight: 600;
}
QWidget#sdkAssistPage QPushButton:hover {
    border-color: #2563EB;
    color: #2563EB;
    background: #EFF6FF;
}
QWidget#sdkAssistPage QPushButton:pressed {
    background: #DBEAFE;
}
QWidget#sdkAssistPage QPushButton:focus {
    border-color: #2563EB;
}
QWidget#sdkAssistPage QPushButton:disabled {
    color: #9CA3AF;
    background: #F3F4F6;
    border-color: #E5E7EB;
}
QWidget#sdkAssistPage QPushButton[buttonRole="primary"] {
    background: #2563EB;
    border-color: #2563EB;
    color: #FFFFFF;
}
QWidget#sdkAssistPage QPushButton[buttonRole="primary"]:hover {
    background: #1D4ED8;
    border-color: #1D4ED8;
    color: #FFFFFF;
}
QWidget#sdkAssistPage QPushButton[buttonRole="primary"]:pressed {
    background: #1E40AF;
    border-color: #1E40AF;
}
QWidget#sdkAssistPage QPushButton[buttonRole="primary"]:focus {
    border-color: #1D4ED8;
}
QWidget#sdkAssistPage QPushButton[buttonRole="primary"]:disabled {
    color: #EFF6FF;
    background: #93C5FD;
    border-color: #93C5FD;
}
QWidget#sdkAssistPage QPushButton[buttonRole="danger"] {
    background: #DC2626;
    border-color: #DC2626;
    color: #FFFFFF;
}
QWidget#sdkAssistPage QPushButton[buttonRole="danger"]:hover {
    background: #B91C1C;
    border-color: #B91C1C;
    color: #FFFFFF;
}
QWidget#sdkAssistPage QPushButton[buttonRole="danger"]:pressed {
    background: #991B1B;
    border-color: #991B1B;
}
QWidget#sdkAssistPage QPushButton[buttonRole="secondary"] {
    background: #FFFFFF;
    border-color: #93C5FD;
    color: #2563EB;
}
QWidget#sdkAssistPage QPushButton[buttonRole="secondary"]:hover {
    background: #EFF6FF;
    border-color: #2563EB;
    color: #1D4ED8;
}
QWidget#sdkAssistPage QPushButton[buttonRole="secondary"]:pressed {
    background: #DBEAFE;
    border-color: #1D4ED8;
    color: #1E40AF;
}
QWidget#sdkAssistPage QPushButton[buttonRole="secondary"]:focus {
    background: #EFF6FF;
    border-color: #2563EB;
}
QWidget#sdkAssistPage QPushButton[buttonRole="secondary"]:disabled {
    color: #9CA3AF;
    background: #F9FAFB;
    border-color: #E5E7EB;
}
QWidget#sdkAssistPage QPushButton[buttonRole="dangerOutline"] {
    background: #FFFFFF;
    border-color: #FCA5A5;
    color: #DC2626;
}
QWidget#sdkAssistPage QPushButton[buttonRole="dangerOutline"]:hover {
    background: #FEF2F2;
    border-color: #DC2626;
    color: #B91C1C;
}
QWidget#sdkAssistPage QPushButton[buttonRole="dangerOutline"]:pressed {
    background: #FEE2E2;
    border-color: #B91C1C;
    color: #991B1B;
}
QWidget#sdkAssistPage QPushButton[buttonRole="dangerOutline"]:focus {
    background: #FEF2F2;
    border-color: #DC2626;
}
QWidget#sdkAssistPage QPushButton[buttonRole="dangerOutline"]:disabled {
    color: #FCA5A5;
    background: #F9FAFB;
    border-color: #FEE2E2;
}
QWidget#sdkAssistPage QPushButton[recordState="recorded"] {
    background: #EFF6FF;
    border-color: #60A5FA;
    color: #1D4ED8;
}
QWidget#sdkAssistPage QPushButton[recordState="recorded"]:hover {
    background: #DBEAFE;
    border-color: #2563EB;
}
QWidget#sdkAssistPage QLineEdit[inputState="error"] {
    background: #FFF7F7;
    border: 1px solid #DC2626;
}
QWidget#sdkAssistPage QLineEdit[inputState="error"]:focus {
    border: 1px solid #B91C1C;
}

/* ---------- sdkAssist 模块7：点位汇总与文件输出工作区 ---------- */
QGroupBox#sdkAssistOutputCard {
    background: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 6px;
    margin: 0;
    padding: 0;
}
QFrame#sdkAssistOutputHeader {
    background: #FFFFFF;
    border: none;
    border-bottom: 1px solid #E5E7EB;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}
QWidget#sdkAssistOutputBody {
    background: #FFFFFF;
    border: none;
}
QGroupBox#sdkAssistOutputCard QLabel#sdkAssistModuleNumber {
    color: #2563EB;
    background: transparent;
    font-size: 10pt;
    font-weight: 700;
}
QLabel#sdkAssistOutputTitle {
    color: #111827;
    background: transparent;
    font-size: 10pt;
    font-weight: 700;
}
QLabel#sdkAssistOutputDescription {
    color: #6B7280;
    background: transparent;
    font-size: 8pt;
}
QLabel#sdkAssistSectionTitle {
    color: #374151;
    background: transparent;
    font-size: 9pt;
    font-weight: 700;
    padding: 2px 0;
}
QFrame#sdkAssistCountItem {
    background: #F9FAFB;
    border: 1px solid #E5E7EB;
    border-radius: 4px;
}
QLabel#sdkAssistCountName {
    color: #6B7280;
    background: transparent;
    font-size: 9pt;
}
QLabel#sdkAssistCountValue {
    color: #2563EB;
    background: transparent;
    font-size: 12pt;
    font-weight: 700;
}
QLabel#sdkAssistOutputPathLabel {
    color: #374151;
    background: transparent;
    font-weight: 600;
}
QLineEdit#sdkAssistOutputPath {
    color: #4B5563;
    background: #F9FAFB;
    border: 1px solid #E5E7EB;
}
QLineEdit#sdkAssistOutputPath:hover,
QLineEdit#sdkAssistOutputPath:focus {
    color: #374151;
    background: #F9FAFB;
    border-color: #D1D5DB;
}
QLabel#sdkAssistOutputStatus {
    min-height: 20px;
    padding: 2px 0;
    color: #6B7280;
    background: transparent;
}
QLabel#sdkAssistOutputStatus[status="idle"] {
    color: #6B7280;
}
QLabel#sdkAssistOutputStatus[status="working"] {
    color: #1D4ED8;
    background: #EFF6FF;
    border: 1px solid #BFDBFE;
    border-radius: 4px;
    padding: 4px 8px;
}
QLabel#sdkAssistOutputStatus[status="success"] {
    color: #15803D;
    background: #F0FDF4;
    border: 1px solid #BBF7D0;
    border-radius: 4px;
    padding: 4px 8px;
}
QLabel#sdkAssistOutputStatus[status="error"] {
    color: #B91C1C;
    background: #FEF2F2;
    border: 1px solid #FECACA;
    border-radius: 4px;
    padding: 4px 8px;
}

/* ---------- 主测量界面专属作用域：后续规则不得影响 sdkAssist ---------- */
QMainWindow#AxisMeasurementClass {
    background: #F5F7FA;
}
QMainWindow#AxisMeasurementClass QWidget#widget,
QMainWindow#AxisMeasurementClass QStackedWidget#uiWidget,
QMainWindow#AxisMeasurementClass QWidget#autoMeasureUI {
    background: #F5F7FA;
    color: #1F2937;
    font-family: "Microsoft YaHei UI", "Microsoft YaHei", sans-serif;
    font-size: 9pt;
}
QMainWindow#AxisMeasurementClass QWidget#autoMeasureUI QGroupBox {
    color: #334155;
    background: #FFFFFF;
    border: 1px solid #E3E8EF;
    border-radius: 8px;
}
QMainWindow#AxisMeasurementClass QWidget#autoMeasureUI QGroupBox::title {
    color: #334155;
    background: transparent;
}
QMainWindow#AxisMeasurementClass QWidget#autoMeasureUI QLabel {
    color: #64748B;
    background: transparent;
}
QMainWindow#AxisMeasurementClass QWidget#autoMeasureUI QLineEdit,
QMainWindow#AxisMeasurementClass QWidget#autoMeasureUI QSpinBox,
QMainWindow#AxisMeasurementClass QWidget#autoMeasureUI QDoubleSpinBox,
QMainWindow#AxisMeasurementClass QWidget#autoMeasureUI QComboBox {
    color: #1F2937;
    background: #FFFFFF;
    border: 1px solid #D7DEE8;
    border-radius: 5px;
    selection-background-color: #DBEAFE;
    selection-color: #1F2937;
}
QMainWindow#AxisMeasurementClass QWidget#autoMeasureUI QLineEdit:hover,
QMainWindow#AxisMeasurementClass QWidget#autoMeasureUI QSpinBox:hover,
QMainWindow#AxisMeasurementClass QWidget#autoMeasureUI QDoubleSpinBox:hover,
QMainWindow#AxisMeasurementClass QWidget#autoMeasureUI QComboBox:hover {
    border-color: #93B4E8;
}
QMainWindow#AxisMeasurementClass QWidget#autoMeasureUI QLineEdit:focus,
QMainWindow#AxisMeasurementClass QWidget#autoMeasureUI QSpinBox:focus,
QMainWindow#AxisMeasurementClass QWidget#autoMeasureUI QDoubleSpinBox:focus,
QMainWindow#AxisMeasurementClass QWidget#autoMeasureUI QComboBox:focus {
