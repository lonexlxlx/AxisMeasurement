    font-size: 9pt;
    font-weight: 400;
}
QMainWindow#AxisMeasurementClass QGroupBox#rightStatsCard QLabel[metricRole],
QMainWindow#AxisMeasurementClass QGroupBox#rightResultCard QLabel[metricRole] {
