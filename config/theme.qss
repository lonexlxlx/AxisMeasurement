    background: #EFF6FF;
    border-color: #93B4E8;
}
QMainWindow#AxisMeasurementClass QWidget#autoMoveAdjust QPushButton[controlRole="motion"]:pressed {
    color: #1D4ED8;
    background: #DBEAFE;
    border-color: #2563EB;
}
QMainWindow#AxisMeasurementClass QWidget#autoMoveAdjust QPushButton[controlRole="motion"]:disabled {
    color: #A7AFBA;
    background: #F1F3F5;
    border-color: #E3E8EF;
}

/* ---------- 主界面中间图像工作区 ---------- */
QMainWindow#AxisMeasurementClass QFrame#frame1 {
    background: #F8FAFC;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
}
QMainWindow#AxisMeasurementClass QFrame#frame1[imageState="idle"] {
    background: #F8FAFC;
    border-color: #CBD5E1;
}
QMainWindow#AxisMeasurementClass QFrame#frame1[imageState="capturing"] {
    background: #F8FAFC;
    border-color: #2563EB;
}
QMainWindow#AxisMeasurementClass QFrame#frame1[imageState="complete"] {
    background: #F8FAFC;
    border-color: #16A34A;
}
QMainWindow#AxisMeasurementClass QFrame#frame1[imageState="error"] {
    background: #FEF2F2;
    border-color: #DC2626;
}
